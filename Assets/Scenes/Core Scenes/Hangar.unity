      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[0].objectiveText
      value: The Cleanser must have a fascination with flying.
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[0].triggerSource
      value: 
      objectReference: {fileID: 1723975762}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[1].objectiveText
      value: More keycards. Great.
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[1].triggerSource
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[2].objectiveText
      value: "Too far to jump\u2026 Wait,\nThat plane might make a decent platform."
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[3].objectiveText
      value: Hah! I'm surprised that worked.
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[4].objectiveText
      value: I hope that lift is still functional.
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[5].objectiveText
      value: 'Now I can reach the third floor!

        I''ll make use of this crane
        too.'
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[6].objectiveText
      value: I can tell something big is coming.
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[7].objectiveText
      value: "\u201CI\u2019m getting there, Cleanser.\r\nYou better be scared.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 3030420007533430126, guid: 6fb40dc1ca724f8488957b4a6657170a, type: 3}
      propertyPath: objectives.Array.data[8].objectiveText
